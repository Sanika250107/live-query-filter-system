{
  "name": "live-query-filter-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {"cors":"^2.8.5","express":"^4.21.2"},
  "devDependencies": {"@vitejs/plugin-react":"^4.4.1","concurrently":"^9.1.2","vite":"^6.1.0","react":"^19.0.0","react-dom":"^19.0.0"}
}
